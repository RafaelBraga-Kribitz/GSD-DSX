// markdownlint-cli2 configuration. Keys verified against the installed
// markdownlint-cli2 v0.23.2 / markdownlint v0.41.1 (2026-09-11).
//
// Scope: the live documentation surface. Run from the repository root:
//     markdownlint-cli2 "**/*.md"
// The exclusions below are deliberate, each with its reason; everything else
// is held to the default rule set with the four documented exceptions.
{
  "gitignore": true,
  "ignores": [
    // Archived milestone records are frozen history; they are not edited after close.
    ".planning/milestones/**",
    // Generated by graphify; regenerated, never hand-edited.
    ".planning/graphs/**",
    "**/graphify-out/**",
    // Generated by gsd-core's intel extraction ("Do not edit by hand").
    ".planning/intel/**",
    // Tool configuration and session state.
    ".claude/**",
    "node_modules/**",
    // Test data: the byte shape of these files IS the test (chart-review
    // fixtures, the Phase-12 catalogue snapshot).
    "tests/fixtures/**",
    // Gate-input fixtures under examples/: read by dsx/checks/narrative.py, the
    // chart-review reader and the claims evidence resolver. Their content is
    // the fixture, so they are not restyled. The POSTMORTEM prose is linted.
    "examples/**/*-NARRATIVE.md",
    "examples/**/*CHART-REVIEW.md",
    "examples/**/*-REPRO-REPORT.md",
    "examples/RESULTS.md"
  ],
  "config": {
    "default": true,
    // Line length: house prose runs long on purpose -- citation lines, tables,
    // and one-sentence-per-line records that the tests parse whole. Wrapping
    // ~2,900 lines would be churn with no rendering or correctness gain.
    "MD013": false,
    // Table pipe spacing: the catalogue tables are emitted by
    // scripts/gen-finding-catalogue.py (`|---|` separators, padded cells) and
    // byte-compared by its --check; hand-written tables copy that shape, and
    // the corpus tests parse them. GitHub renders every style identically.
    "MD060": false,
    // Skill, agent and fragment files are prompts: their sections are XML-style
    // tags (<objective>, <process>, <inputs>, ...) read by the GSD runtime,
    // not HTML to be rendered.
    "MD033": false,
    // Those same prompt files open with a section tag, and measurement records
    // open with a machine-read sentinel line (`VERDICT: LIVE MISS`), not a
    // heading.
    "MD041": false,
    // Retrospectives repeat the same section headings under every milestone;
    // a duplicate is only a problem between siblings.
    "MD024": { "siblings_only": true }
  }
}
