# DSX style: dsx-bbc
# Source: BBC Visual & Data Journalism R Cookbook https://bbc.github.io/rcookbook/ (cited, not ported)
# License: rcParams are our own derivation; bbplot is GPL-2.0 — its code is never ported
# Vendoring: none — our own rcParams; no bbplot code line is copied
# Font: resolves font.family to vendored Lato (SIL OFL 1.1) as an open stand-in for the proprietary Reith face, styles/fonts/Lato-Regular.ttf
# Palette: WCAG-AA verified (tests/test_style_wcag_contrast.py); BBC cookbook palette (blue 1380a1, dark red 990000, green 588300 retained), the light yellow replaced by a dark gold and greys darkened so every series clears 3:1 on white — our own derivation
# Reimplemented from published doctrine; not affiliated with or endorsed by the BBC; no source-PDF text, no GPL code, and no proprietary font are included.

axes.prop_cycle: cycler('color', ['1380a1', '990000', '588300', 'b35806', '636363'])
axes.facecolor: ffffff
axes.edgecolor: 222222
axes.linewidth: 0.8
axes.labelsize: large
axes.axisbelow: true
axes.grid: true
axes.grid.axis: y
axes.titlesize: x-large
axes.labelcolor: 222222
axes.spines.top: false
axes.spines.right: false

legend.frameon: false

text.color: 222222
xtick.color: 222222
ytick.color: 222222

font.family: sans-serif
font.sans-serif: Lato, DejaVu Sans

svg.fonttype: path
svg.hashsalt: dsx

grid.linestyle: -
grid.linewidth: 0.7
grid.color: cbcbcb

xtick.major.size: 0
ytick.major.size: 0

font.size: 13.0

figure.facecolor: ffffff
